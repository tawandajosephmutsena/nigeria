APP_NAME="UNFINISHED"
APP_ENV=production
APP_KEY=base64:dJ83eJ0t22460Ch6bhqWY7alHkZseWO0wK7DxTA9VVk=
APP_DEBUG=false
APP_URL=https://unfinished.africa

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# SQLite Database (Default - Pre-seeded & Ready to run immediately)
DB_CONNECTION=sqlite
# On cPanel, if left empty, Laravel automatically uses {base_path}/database/database.sqlite
# Or you can explicitly specify the absolute path:
# DB_DATABASE=/home/YOUR_CPANEL_USER/unfinished.africa/database/database.sqlite

# MySQL Database (Alternative - uncomment if using a cPanel MySQL database)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpaneluser_nigeria
# DB_USERNAME=cpaneluser_user
# DB_PASSWORD=your_mysql_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# WhatsApp Contact & Campaign Desk
WHATSAPP_NUMBER="+234 915 068 4078"

# Mail Settings (Configure if sending emails through cPanel SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.unfinished.africa
MAIL_PORT=465
MAIL_USERNAME=info@unfinished.africa
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@unfinished.africa"
MAIL_FROM_NAME="${APP_NAME}"
